# Copy this file to `.env` before starting the stack:
#   cp .env.example .env
# Generate the encryption key once and keep it backed up:
#   openssl rand -hex 32

# Published image used by the default Compose deployment.
IMAGE_NAME=ghcr.io/bhxnms/tt-planner
IMAGE_TAG=0.7.0
# Set APP_VERSION when building from source with `docker compose build`.
APP_VERSION=0.7.0

# Host port. The container always listens on 3000.
HOST_PORT=3000

# Required together for a predictable first admin account. These are used only
# on the first boot when the database contains no users.
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=replace-with-a-long-random-password

# Recommended: persistent encryption for API keys, MFA, SMTP and OIDC secrets.
# Replace this placeholder with the output of `openssl rand -hex 32`.
ENCRYPTION_KEY=replace-with-64-hex-characters

TZ=UTC
LOG_LEVEL=info
# ALLOWED_ORIGINS=https://planner.example.com
# TREK_PLUGIN_HOST_VERSION=4.2.1

# Cloudflare Tunnel (optional). The token goes to the cloudflared sidecar in
# docker-compose.yml; the app itself never reads it. Set APP_URL to the tunnel
# hostname and TRUST_PROXY to the number of proxies in front of the app (1 for
# Cloudflare directly, 2 with your own reverse proxy in between). The admin
# panel (Admin → Cloudflare Tunnel) can generate these for you.
# CLOUDFLARE_TUNNEL_TOKEN=
# APP_URL=https://tt.example.com
# TRUST_PROXY=1

# For SSO, uncomment and configure APP_URL, OIDC_* and optionally OIDC_ONLY.
# OIDC_ONLY=true disables password login; the first SSO user becomes admin.
